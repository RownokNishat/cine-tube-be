  "description": "CineTube - Movie and Series Rating & Streaming Portal",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc && node scripts/fix-imports.js",
    "vercel-build": "prisma generate && ./node_modules/.bin/esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=api/index.js",
    "start": "node dist/server.js",
    "lint": "eslint ./src/**/*",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
