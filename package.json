    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.4.0",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.18.0",
    "@types/qs": "^6.14.0",
    "@types/uuid": "^11.0.0",
    "esbuild": "^0.27.0",
    "prisma": "^7.4.2",
